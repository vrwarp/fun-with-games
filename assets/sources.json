{
  "$schema": "./sources.schema.json",
  "comment": [
    "Catalogue of third-party assets to download with `npm run assets:fetch`.",
    "Downloaded files land in public/assets/vendor/, which is gitignored — the",
    "catalogue is the thing under version control, not the binaries.",
    "",
    "Every entry MUST carry accurate licence metadata. `npm run assets:verify`",
    "fails the build if any is missing, and CI runs it on every push.",
    "",
    "Good CC0 / permissive sources are listed in docs/ASSETS.md."
  ],
  "assets": [
    {
      "id": "sky",
      "url": "https://dl.polyhaven.org/file/ph-assets/HDRIs/hdr/2k/wasteland_clouds_puresky_2k.hdr",
      "file": "sky.hdr",
      "enabled": true,
      "description": "Late-afternoon partly-cloudy sky with a low warm sun and horizon haze. Serves as both the visible sky dome and the image-based lighting environment.",
      "meta": {
        "kind": "environment",
        "rotationY": -1.161,
        "horizon": [0.603, 0.646, 0.632]
      },
      "license": {
        "name": "CC0-1.0",
        "source": "https://polyhaven.com/a/wasteland_clouds_puresky",
        "author": "Sergej Majboroda (original); Jarod Guest (sky edits)"
      },
      "sha256": "c9be5b722797528f2deae5969d6af061e75fca912675bcb11d467de5eea427c6"
    },
